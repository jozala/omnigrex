FROM golang:1.27.0-bookworm@sha256:ded31c68586d2e49e760acc2e65a884b23d032e9bbbed0ae0c55abd3fcaf4452 AS toolchain

# Download packages only; Debian build-stage executables never enter Ubuntu.
FROM toolchain AS git-download
ARG TARGETARCH
COPY agent/microsandbox/deb-packages.sha256 /tmp/deb-packages.sha256
RUN test "$TARGETARCH" = amd64 && mkdir /debs && \
    packages=0 && \
    while read -r checksum asset; do \
      case "$checksum" in ''|'#'*) continue ;; esac; \
      file="/debs/${asset##*/}"; \
      curl --fail --silent --show-error --location "https://archive.ubuntu.com/ubuntu/$asset" -o "$file" || exit 1; \
      echo "$checksum  $file" | sha256sum -c - || exit 1; \
      packages=$((packages + 1)); \
    done < /tmp/deb-packages.sha256 && \
    test "$packages" -eq 24

FROM toolchain AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY cmd ./cmd
COPY internal ./internal
COPY agent/pi ./agent/pi
ARG VERSION=dev
RUN --mount=type=cache,target=/root/.cache/go-build CGO_ENABLED=1 go build -tags=microsandbox -trimpath -ldflags="-s -w -X main.version=$VERSION" -o /out/omnigrex ./cmd/omnigrex

FROM build AS test-build
RUN --mount=type=cache,target=/root/.cache/go-build CGO_ENABLED=1 go test -c -race -tags=integration,microsandbox -o /out/microsandbox.test ./internal/runtime/microsandbox

FROM build AS pi-test-build
RUN --mount=type=cache,target=/root/.cache/go-build CGO_ENABLED=1 go test -c -race -tags=integration,microsandbox -o /out/pi.test ./internal/runtime/pi

FROM ghcr.io/superradcompany/microsandbox@sha256:be3d9f5f99b937ac4c4452b2ff33657a4ef74a117fdb584abb6d3c7db53e248f AS git-runtime
# The digest is Ubuntu Noble/amd64 with glibc 2.39 and CA certificates.
# Install the locked Noble dependency closure without network/package fallback.
RUN --network=none --mount=type=bind,from=git-download,source=/debs,target=/tmp/debs,readonly \
    test "$(dpkg --print-architecture)" = amd64 && \
    . /etc/os-release && test "$ID:$VERSION_ID" = ubuntu:24.04 && \
    dpkg --install /tmp/debs/*.deb && \
    test "$(git --version)" = 'git version 2.43.0' && \
    test "$(dpkg-query -W -f='${Version}' ca-certificates)" = '20260601~24.04.1' && \
    test -s /etc/ssl/certs/ca-certificates.crt && \
    test -x /usr/lib/git-core/git-remote-https

FROM git-runtime AS runtime
COPY --from=build /out/omnigrex /usr/local/bin/omnigrex
RUN mkdir -p /var/lib/omnigrex/msb/tmp /var/lib/omnigrex/workspaces /var/lib/omnigrex/runtime-state /var/lib/omnigrex/mise && chown -R 10001:10001 /var/lib/omnigrex
ENV OMNIGREX_EXECUTION_BACKEND=microsandbox
USER 10001:10001
ENTRYPOINT ["/usr/local/bin/omnigrex"]

FROM runtime AS qualification
COPY --from=test-build /out/microsandbox.test /usr/local/bin/microsandbox.test
COPY experiments/microsandbox/testdata /fixtures
ENV HOME=/tmp OMNIGREX_MICROSANDBOX_INTEGRATION=1
ENTRYPOINT ["/usr/local/bin/microsandbox.test"]
CMD ["-test.v", "-test.timeout", "30m"]

FROM runtime AS pi-qualification
COPY --from=pi-test-build /out/pi.test /usr/local/bin/pi.test
ENV HOME=/tmp OMNIGREX_PI_PROTOCOL_INTEGRATION=1 OMNIGREX_PI_BACKEND=microsandbox
ENTRYPOINT ["/usr/local/bin/pi.test"]
CMD ["-test.v", "-test.timeout", "15m"]

FROM build AS pi-workflow-test-build
RUN --mount=type=cache,target=/root/.cache/go-build CGO_ENABLED=1 go test -c -race -tags=integration,microsandbox -o /out/workflow.test ./internal/store

FROM runtime AS pi-workflow-qualification
COPY --from=pi-workflow-test-build /out/workflow.test /usr/local/bin/workflow.test
ENV HOME=/tmp
ENTRYPOINT ["/usr/local/bin/workflow.test"]
