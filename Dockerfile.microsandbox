FROM golang:1.27.0-bookworm@sha256:ded31c68586d2e49e760acc2e65a884b23d032e9bbbed0ae0c55abd3fcaf4452 AS toolchain

# SDK 0.7.11 supports an external agentd payload. Keep execs in a leaf while
# retaining the original domain root as the aggregate freezer and PID budget.
FROM toolchain AS agentd-source
WORKDIR /src
RUN curl --fail --silent --show-error --location \
      https://codeload.github.com/superradcompany/microsandbox/tar.gz/df3e0f7dd69280b88f6e28d6d3cf5fe4bb4a87a0 -o /tmp/microsandbox.tar.gz && \
    echo 'c79dcdfbc262d487dd595e26dab832de3b77f0bc08321ef642a02ff4861d8a41  /tmp/microsandbox.tar.gz' | sha256sum -c - && \
    tar -xzf /tmp/microsandbox.tar.gz --strip-components=1 -C /src && rm /tmp/microsandbox.tar.gz
COPY agent/microsandbox/agentd-domain-cgroups.patch /tmp/agentd.patch
RUN git apply --check /tmp/agentd.patch && git apply /tmp/agentd.patch

FROM rust:1.99.0-alpine3.24@sha256:0cce0a5e0e8ba67b455257a3a02a1d99005f382748789d6464460028810f1627 AS agentd-build
ARG TARGETARCH
WORKDIR /src
COPY --from=agentd-source /src/ ./
ENV RUSTFLAGS="-C target-feature=+crt-static"
RUN test "$TARGETARCH" = amd64 && \
    cargo test --locked --jobs 2 --target x86_64-unknown-linux-musl -p microsandbox-agentd --lib workload::tests && \
    cargo build --locked --jobs 2 --target x86_64-unknown-linux-musl --release -p microsandbox-agentd

FROM toolchain AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY cmd ./cmd
COPY internal ./internal
COPY agent/pi ./agent/pi
ARG VERSION=dev
RUN --mount=type=cache,target=/root/.cache/go-build CGO_ENABLED=1 go build -tags=microsandbox -trimpath -ldflags="-s -w -X main.version=$VERSION" -o /out/omnigrex ./cmd/omnigrex

FROM toolchain AS catalog-v076-build
WORKDIR /src
COPY internal/runtime/microsandbox/testdata/catalog-v076/ ./
RUN CGO_ENABLED=1 go build -mod=readonly -trimpath -o /out/catalog-v076 .

FROM build AS test-build
RUN --mount=type=cache,target=/root/.cache/go-build CGO_ENABLED=1 go test -c -race -tags=integration,microsandbox -o /out/microsandbox.test ./internal/runtime/microsandbox

FROM build AS pi-test-build
RUN --mount=type=cache,target=/root/.cache/go-build CGO_ENABLED=1 go test -c -race -tags=integration,microsandbox -o /out/pi.test ./internal/runtime/pi

FROM ghcr.io/superradcompany/microsandbox@sha256:bdaca423e18beb4a62a6664935de9457c1b3217e0479efce1cc961ee59448734 AS git-runtime
# The digest is Ubuntu Noble/amd64 with glibc 2.39 and CA certificates.
# Resolve Git from the base image's signed Ubuntu repositories.
RUN apt-get update && \
    apt-get install -y --no-install-recommends git && \
    rm -rf /var/lib/apt/lists/* && \
    git --version && \
    test -s /etc/ssl/certs/ca-certificates.crt && \
    test -x /usr/lib/git-core/git-remote-https

FROM git-runtime AS runtime
COPY --from=build /out/omnigrex /usr/local/bin/omnigrex
COPY --from=agentd-build /src/target/x86_64-unknown-linux-musl/release/agentd /usr/local/lib/omnigrex/agentd
COPY --from=agentd-source /src/LICENSE /usr/share/licenses/omnigrex/microsandbox-agentd/LICENSE
RUN mkdir -p /usr/share/omnigrex && printf '%s\n' 'df3e0f7dd69280b88f6e28d6d3cf5fe4bb4a87a0 patched-domain-cgroups' > /usr/share/omnigrex/microsandbox-agentd-source
RUN mkdir -p /var/lib/omnigrex/msb/tmp /var/lib/omnigrex/workspaces /var/lib/omnigrex/runtime-state /var/lib/omnigrex/mise /var/lib/omnigrex/provider-auth && chown -R 10001:10001 /var/lib/omnigrex
ENV OMNIGREX_EXECUTION_BACKEND=microsandbox
ENV MSB_AGENTD_PATH=/usr/local/lib/omnigrex/agentd
USER 10001:10001
ENTRYPOINT ["/usr/local/bin/omnigrex"]

FROM runtime AS qualification
USER root
RUN apt-get update && apt-get install -y --no-install-recommends sqlite3 && rm -rf /var/lib/apt/lists/*
USER 10001:10001
COPY --from=catalog-v076-build /out/catalog-v076 /usr/local/bin/catalog-v076
COPY --from=test-build /out/microsandbox.test /usr/local/bin/microsandbox.test
COPY internal/runtime/microsandbox/testdata/nested /fixtures
ENV HOME=/tmp OMNIGREX_MICROSANDBOX_INTEGRATION=1
ENTRYPOINT ["/usr/local/bin/microsandbox.test"]
CMD ["-test.v", "-test.timeout", "30m"]

FROM qualification AS development-qualification
COPY . /fixtures/development
# The normal context excludes docs; qualification checks public docs and examples.
COPY --from=development-docs / /fixtures/development/docs/
ENTRYPOINT ["/usr/local/bin/microsandbox.test"]

FROM runtime AS pi-qualification
COPY --from=pi-test-build /out/pi.test /usr/local/bin/pi.test
ENV HOME=/tmp OMNIGREX_PI_PROTOCOL_INTEGRATION=1 OMNIGREX_PI_BACKEND=microsandbox
ENTRYPOINT ["/usr/local/bin/pi.test"]
CMD ["-test.v", "-test.timeout", "15m"]

FROM build AS pi-workflow-test-build
RUN --mount=type=cache,target=/root/.cache/go-build CGO_ENABLED=1 go test -c -race -tags=integration,microsandbox -o /out/workflow.test ./internal/store

FROM runtime AS pi-workflow-qualification
COPY --from=pi-workflow-test-build /out/workflow.test /usr/local/bin/workflow.test
ENV HOME=/tmp
ENTRYPOINT ["/usr/local/bin/workflow.test"]
