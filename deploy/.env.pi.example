# Use compose.pi.yaml together with exactly one backend file.
# See docs/operator-guide.md#pi-operational-deployment for the procedure.
OMNIGREX_ORCHESTRATOR_IMAGE=
OMNIGREX_PI_IMAGE=
OMNIGREX_PI_PLATFORM=linux/amd64
OMNIGREX_DOCKER_GID=0
OMNIGREX_MICROSANDBOX_KVM_GID=
OMNIGREX_SECRET_GID=
OMNIGREX_MICROSANDBOX_NAMESPACE=omnigrex
OMNIGREX_MICROSANDBOX_CPUS=2
OMNIGREX_MICROSANDBOX_ROOT_DISK_MIB=20480
OMNIGREX_HTTP_PORT=8080
OMNIGREX_READINESS_TIMEOUT=60s
# Keep this at least ten seconds longer than the readiness budget.
OMNIGREX_HEALTHCHECK_TIMEOUT=70s
OMNIGREX_CONTROL_PLANE_MEMORY=6g
OMNIGREX_AGENT_TURN_CONCURRENCY_LIMIT=2
OMNIGREX_AGENT_TURN_MEMORY_MIB=1024
OMNIGREX_PI_STARTUP_TIMEOUT=10m
OMNIGREX_DATABASE_PASSWORD_FILE=./secrets/database-password
OMNIGREX_GITHUB_DEVELOPER_APP_ID=
OMNIGREX_GITHUB_REVIEWER_APP_ID=
OMNIGREX_GITHUB_DEVELOPER_PRIVATE_KEY_FILE=./secrets/github-developer-private-key.pem
OMNIGREX_GITHUB_REVIEWER_PRIVATE_KEY_FILE=./secrets/github-reviewer-private-key.pem
OMNIGREX_GITHUB_WEBHOOK_SECRET_FILE=./secrets/github-webhook-secret
OMNIGREX_PROVIDER_CREDENTIALS_FILE=./secrets/provider-credentials.json
OMNIGREX_RUNTIME_PROFILE_COMPATIBILITY_RESULTS_FILE=
