OMNIGREX_HTTP_ADDR=:8080
OMNIGREX_HEALTHCHECK_URL=http://127.0.0.1:8080/readyz
OMNIGREX_HTTP_PORT=8080
OMNIGREX_READINESS_TIMEOUT=15s
OMNIGREX_SHUTDOWN_TIMEOUT=10s
OMNIGREX_MCP_MUTATION_OPERATION_TIMEOUT=2h
# Mutable local image used only by deployment readiness checks.
OMNIGREX_AGENT_IMAGE_REFERENCE=omnigrex/opencode:1.18.19
# Immutable image and platform for the opencode-acp/v1 deployment Runtime Profile.
OMNIGREX_OPENCODE_ACP_V1_IMAGE=
OMNIGREX_OPENCODE_ACP_V1_PLATFORM=linux/amd64
# Use 0 with Docker Desktop. On Linux, use: stat -c '%g' /var/run/docker.sock
OMNIGREX_DOCKER_GID=0
# Set this to a dedicated host secret-file group ID distinct from OMNIGREX_DOCKER_GID.
OMNIGREX_SECRET_GID=
OMNIGREX_DATABASE_PASSWORD_FILE=./secrets/database-password
OMNIGREX_GITHUB_API_URL=https://api.github.com
OMNIGREX_GIT_REMOTE_BASE_URL=https://github.com
OMNIGREX_GITHUB_DEVELOPER_APP_ID=
OMNIGREX_GITHUB_REVIEWER_APP_ID=
OMNIGREX_GITHUB_DEVELOPER_PRIVATE_KEY_FILE=./secrets/github-developer-private-key.pem
OMNIGREX_GITHUB_REVIEWER_PRIVATE_KEY_FILE=./secrets/github-reviewer-private-key.pem
OMNIGREX_GITHUB_WEBHOOK_SECRET_FILE=./secrets/github-webhook-secret
OMNIGREX_WEBHOOK_LEASE_DURATION=30s
OMNIGREX_WEBHOOK_POLL_INTERVAL=250ms
OMNIGREX_AGENT_TURN_PREPARATION_LEASE_DURATION=30s
OMNIGREX_AGENT_TURN_PREPARATION_HEARTBEAT_INTERVAL=10s
OMNIGREX_AGENT_TURN_PREPARATION_POLL_INTERVAL=250ms
OMNIGREX_AGENT_TURN_PREPARATION_RETRY_DELAY=5s
OMNIGREX_AGENT_TURN_EXECUTION_LEASE_DURATION=30s
OMNIGREX_AGENT_TURN_EXECUTION_HEARTBEAT_INTERVAL=10s
OMNIGREX_AGENT_TURN_EXECUTION_POLL_INTERVAL=250ms
OMNIGREX_AGENT_TURN_EXECUTION_TURN_TIMEOUT=2h
OMNIGREX_AGENT_TURN_EXECUTION_CLEANUP_TIMEOUT=10s
OMNIGREX_AGENT_TURN_CONCURRENCY_LIMIT=2
OMNIGREX_WORKFLOW_EFFECT_LEASE_DURATION=30s
OMNIGREX_WORKFLOW_EFFECT_HEARTBEAT_INTERVAL=10s
OMNIGREX_WORKFLOW_EFFECT_POLL_INTERVAL=250ms
OMNIGREX_WORKFLOW_EFFECT_RETRY_DELAY=5s
OMNIGREX_DEVELOPER_PROVIDER_CREDENTIALS_FILE=./secrets/developer-provider-credentials.json
OMNIGREX_REVIEWER_PROVIDER_CREDENTIALS_FILE=./secrets/reviewer-provider-credentials.json
