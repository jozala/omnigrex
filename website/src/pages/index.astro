---
import ThemeProvider from '@astrojs/starlight/components/ThemeProvider.astro';
import ThemeSelect from '@astrojs/starlight/components/ThemeSelect.astro';
import Brand from '../components/Brand.astro';
import Icon from '../components/Icon.astro';
import '../styles/brand.css';
import '../styles/home.css';

const github = 'https://github.com/jozala/omnigrex';
const capabilities = [
  { icon: 'branch', title: 'A Workflow you can follow', text: 'An Issue becomes a Work Item. A Developer opens a Pull Request, a separate Reviewer evaluates it, and you decide what ships.' },
  { icon: 'check', title: 'A second pair of eyes', text: 'Developer and Reviewer use separate GitHub Apps. Review findings return to the Developer before the Change Proposal reaches you.' },
  { icon: 'server', title: 'Your infrastructure', text: 'Run the control plane with Docker Compose and PostgreSQL. Choose Docker or Linux/KVM Microsandbox execution for the agents.' },
] as const;
const principles = [
  ['Meet humans where they are', 'Start work, follow progress, and answer agent questions in GitHub. No separate inbox to watch.'],
  ['Keep knowledge with the project', 'Instructions, requirements, plans, and decisions belong beside the code and the Issues they explain.'],
  ['Give Roles their own perspective', 'Separate responsibilities and permissions make review more than asking the coding agent to check its own work.'],
  ['Put limits on autonomy', 'Bound retries and Review Cycles. When the agents need your judgment, hand back a clear question instead of looping.'],
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Omnigrex - build an AI team around your software project</title>
    <meta name="description" content="A self-hosted, open-source platform for software-development agents. Turn GitHub Issues into independently reviewed Pull Requests, while you decide what ships." />
    <link rel="canonical" href="https://omnigrex.com/" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <ThemeProvider />
    <script is:inline defer src="https://analytics.aetas.pl/script.js" data-website-id="4d959188-0deb-4993-8e8b-3468b9d74aad" data-domains="omnigrex.com,www.omnigrex.com"></script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="home-header">
      <div class="container header-inner">
        <Brand />
        <nav class="main-nav" aria-label="Main navigation">
          <a class="section-link" href="#how-it-works">How it works</a>
          <a class="section-link" href="#principles">Principles</a>
          <a class="docs-link" href="/docs/"><span class="docs-label-long">Documentation</span><span class="docs-label-short">Docs</span> <Icon name="arrow" size={15} /></a>
        </nav>
        <div class="header-tools">
          <a class="github-link" href={github} aria-label="Omnigrex on GitHub"><Icon name="github" /></a>
          <ThemeSelect />
        </div>
      </div>
    </header>

    <main id="main">
      <div class="hero-region" id="top">
        <div class="container hero">
          <div class="hero-copy">
            <a class="eyebrow release-note" href="#status"><span class="status-dot"></span> OPEN SOURCE · SELF-HOSTED · IN DEVELOPMENT</a>
            <h1>Build a team <br />of agents.<br /><span>Keep the lead.</span></h1>
            <p class="hero-description">Bring software-development agents into your GitHub project. Let them write code and review each other’s work. You set the direction and decide what ships.</p>
            <div class="hero-actions">
              <a class="button primary" href="/docs/">Get started <Icon name="arrow" size={18} /></a>
              <a class="button secondary" href={github}><Icon name="github" size={18} /> Explore on GitHub</a>
            </div>
            <p class="hero-footnote">Your repository. Your models. Your infrastructure.</p>
          </div>

          <div class="workflow-preview" aria-label="Illustration of the current Developer and Reviewer Workflow">
            <div class="preview-bar"><span class="window-dots" aria-hidden="true"><i></i><i></i><i></i></span><span>ONE ISSUE. A TEAM AT WORK.</span><Icon name="branch" size={15} /></div>
            <div class="preview-content">
              <div class="issue-heading"><span class="issue-symbol"><Icon name="issue" size={24} /></span><div><span class="small-label">YOUR GITHUB ISSUE</span><h2>A small change, ready for the team.</h2></div></div>
              <div class="issue-label"><span class="status-dot"></span><code>omnigrex:run</code></div>
              <div class="agent-timeline">
                <div class="agent-step"><span class="agent-avatar developer"><Icon name="code" size={20} /></span><div><div class="step-heading"><strong>Developer</strong><span class="step-tag">BUILD</span></div><p>Reads the Work Item, changes the code,<br class="wide-only" /> and opens a Pull Request.</p></div></div>
                <div class="agent-step"><span class="agent-avatar reviewer"><Icon name="check" size={20} /></span><div><div class="step-heading"><strong>Reviewer</strong><span class="step-tag">REVIEW</span></div><p>Evaluates the Change Proposal<br class="wide-only" /> from an independent perspective.</p></div></div>
                <div class="review-loop"><span aria-hidden="true">↳</span> Findings go back to the Developer.</div>
                <div class="agent-step"><span class="agent-avatar human">YOU</span><div><div class="step-heading"><strong>Your call</strong><span class="step-tag">DECIDE</span></div><p>Review the result. Merge when you’re ready.</p></div></div>
              </div>
            </div>
            <div class="preview-footer"><span class="status-dot"></span> The conversation stays in GitHub.</div>
          </div>
        </div>
        <div class="container foundation-strip"><span>BUILT AROUND YOUR PROJECT</span><div><Icon name="github" size={17} /> GitHub-native</div><div><Icon name="server" size={17} /> Self-hosted</div><div><Icon name="code" size={17} /> Open source, MIT licensed</div></div>
      </div>

      <section class="container section" id="idea">
        <div class="section-intro"><span class="eyebrow">THE IDEA</span><h2>The team around<br />the code matters.</h2><p>A coding agent is one part of the job. Omnigrex coordinates the work around it: the handoff, the independent review, and the point where a human needs to step in.</p></div>
        <div class="capability-grid">
          {capabilities.map(({ icon, title, text }) => <article class="capability"><span class="feature-icon"><Icon name={icon} size={25} /></span><h3>{title}</h3><p>{text}</p></article>)}
        </div>
      </section>

      <section class="tinted-section" id="how-it-works">
        <div class="container section">
          <div class="section-heading"><div><span class="eyebrow">HOW IT WORKS TODAY</span><h2>Start with an Issue.<br />Finish with a decision.</h2></div><p>GitHub is the everyday interface.<br />Omnigrex handles the coordination behind it.</p></div>
          <ol class="workflow-steps">
            <li><span class="step-number">01</span><h3>Bring the work</h3><p>Open a focused Issue with acceptance criteria. Add <code>omnigrex:run</code> to start the Workflow.</p></li>
            <li><span class="step-number">02</span><h3>Let the agents work</h3><p>The Developer prepares a Change Proposal. The Reviewer evaluates it and can request another pass.</p></li>
            <li><span class="step-number">03</span><h3>Stay in the loop</h3><p>Answer questions when judgment is needed. Review the Pull Request and choose whether to merge.</p></li>
          </ol>
          <a class="text-link" href="/docs/users/first-work-item/">Walk through your first Work Item <Icon name="arrow" size={17} /></a>
        </div>
      </section>

      <section class="container section architecture-section" id="architecture">
        <div class="architecture-copy"><span class="eyebrow">UNDER THE HOOD</span><h2>Your machines.<br />A controlled Workflow.</h2><p>A Go orchestrator owns coordination and recovery. PostgreSQL keeps the durable record. Pi runs Agent Turns in disposable execution environments, while persistent Agent Sessions carry context forward.</p><p>Use Docker execution or Linux/KVM Microsandbox. Configure Agent Profiles, models, skills, and development environments in your repository.</p><a class="text-link" href="/docs/contributors/architecture/">Read the architecture <Icon name="arrow" size={17} /></a></div>
        <div class="architecture-diagram" role="img" aria-label="GitHub connects to the Omnigrex orchestrator and PostgreSQL ledger. The orchestrator coordinates Developer and Reviewer Pi Runtime Processes in Docker or Microsandbox execution environments.">
          <div class="arch-github"><Icon name="github" size={20} /><strong>GitHub</strong><span>Issues · Pull Requests · Reviews</span></div>
          <div class="arch-connector" aria-hidden="true">↕</div>
          <div class="arch-control"><span class="small-label">CONTROL PLANE</span><strong>Omnigrex orchestrator</strong><span>Go <b>+</b> PostgreSQL</span></div>
          <div class="arch-connector" aria-hidden="true">↓</div>
          <div class="arch-agents"><div><span class="mini-dot blue"></span><strong>Developer</strong><span>Pi Runtime Process</span></div><div><span class="mini-dot violet"></span><strong>Reviewer</strong><span>Pi Runtime Process</span></div></div>
          <div class="arch-environment">Docker or Linux/KVM Microsandbox</div>
        </div>
      </section>

      <section class="vision-section" id="roles">
        <div class="container vision-inner"><div><span class="eyebrow">THE LONGER-TERM VISION</span><h2>Grow a project together.</h2><p>The ambition goes beyond coding and review: specialists in product, architecture, and QA working from shared project knowledge. Different work could call for different teams.</p><p class="vision-caveat">That is the direction, not a list of shipped features. The current software provides the Developer/Reviewer Workflow described above.</p><a class="text-link" href={`${github}/blob/main/project-concept.md`}>Explore the project vision on GitHub <Icon name="arrow" size={17} /></a></div><blockquote>“Can we create an autonomous organization of agents that, across many consecutive tasks, can maintain product, architecture, and project-knowledge consistency without constant human supervision?”<cite>The project’s core hypothesis</cite></blockquote></div>
      </section>

      <section class="container section" id="principles">
        <div class="section-intro"><span class="eyebrow">PROJECT PRINCIPLES</span><h2>Autonomy needs<br />clear boundaries.</h2></div>
        <div class="principles-grid">{principles.map(([title, text], index) => <article><span class="principle-index">0{index + 1}</span><div><h3>{title}</h3><p>{text}</p></div></article>)}</div>
      </section>

      <section class="container status-section" id="status">
        <div class="status-copy"><span class="eyebrow"><span class="status-dot"></span> BUILT IN THE OPEN</span><h2>Early days.<br />Real work.</h2><p>Omnigrex is helping build itself. Its Developer and Reviewer have contributed merged Pull Requests to this repository. The project is in active early development and currently supports trusted repositories only.</p><p>Try it on a project you control, read the code, or help shape what comes next.</p><div class="hero-actions"><a class="button primary" href="/docs/">Get started <Icon name="arrow" size={18} /></a><a class="button secondary" href={github}>View the repository <Icon name="github" size={18} /></a></div></div>
        <div class="getting-started"><span class="small-label">FIND YOUR STARTING POINT</span><a href="/docs/operators/installation/"><span><strong>Deploy an installation</strong><small>For operators</small></span><Icon name="arrow" /></a><a href="/docs/repository-owners/connect-a-repository/"><span><strong>Connect your repository</strong><small>For repository owners</small></span><Icon name="arrow" /></a><a href="/docs/users/first-work-item/"><span><strong>Start your first Work Item</strong><small>For users of a configured repository</small></span><Icon name="arrow" /></a><a href="/docs/contributors/"><span><strong>Build it with us</strong><small>For contributors</small></span><Icon name="arrow" /></a></div>
      </section>
    </main>

    <footer class="home-footer"><div class="container footer-inner"><div><Brand /><p>A software-development team.<br />Built around your project.</p></div><nav aria-label="Footer navigation"><a href="/docs/">Documentation</a><a href={github}>GitHub</a><a href={`${github}/blob/main/LICENSE`}>MIT license</a><a href="/fonts/montserrat-license.txt">Font license</a></nav><span class="footer-note">Self-hosted. Open source.<br />Human-led.</span></div></footer>
  </body>
</html>
