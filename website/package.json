    "astro": "7.4.5",
    "github-slugger": "2.0.0",
    "gray-matter": "4.0.3",
    "mdast-util-to-string": "4.0.0",
    "parse5": "8.0.0",
    "remark-parse": "11.0.0",
    "unified": "11.0.5"
  }
